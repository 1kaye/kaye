{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/kaye/branding/logo.txt",
    "color": { "1": "blue" },
    "padding": {
      "top": 1,
      "right": 4,
      "left": 2
    }
  },
  "modules": [
    "title",
    "separator",
    { "type": "custom", "key": "OS", "format": "Kaye OS (Arch Linux)" },
    "kernel",
    "uptime",
    "packages",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "break",
    "colors"
  ]
}
